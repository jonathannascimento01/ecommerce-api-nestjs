generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tbl_addresses {
  address_id    BigInt        @id @default(autoincrement())
  customer_id   BigInt
  zip_code      String        @db.VarChar(9)
  street        String        @db.VarChar(120)
  number        String?       @db.VarChar(20)
  complement    String?       @db.VarChar(80)
  district      String?       @db.VarChar(80)
  city          String?       @db.VarChar(80)
  state         String?       @db.Char(2)
  is_default    Boolean       @default(false)
  tbl_customers tbl_customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tbl_addresses_customer")

  @@index([customer_id], map: "idx_tbl_addresses_customer")
}

model tbl_brands {
  brand_id     BigInt         @id @default(autoincrement())
  brand_name   String         @unique(map: "uq_tbl_brands_name") @db.VarChar(80)
  active       Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  tbl_products tbl_products[]

  @@index([active], map: "idx_tbl_brands_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tbl_cart_items {
  cart_item_id BigInt       @id @default(autoincrement())
  cart_id      BigInt
  product_id   BigInt
  quantity     Int
  tbl_carts    tbl_carts    @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tbl_cart_items_cart")
  tbl_products tbl_products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_cart_items_product")

  @@unique([cart_id, product_id], map: "uq_tbl_cart_item")
  @@index([cart_id], map: "idx_tbl_cart_items_cart")
}

model tbl_carts {
  cart_id        BigInt           @id @default(autoincrement())
  customer_id    BigInt           @unique(map: "uq_tbl_carts_customer")
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime         @default(now()) @db.Timestamp(6)
  tbl_cart_items tbl_cart_items[]
  tbl_customers  tbl_customers    @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_carts_customer")
}

model tbl_categories {
  category_id   BigInt         @id @default(autoincrement())
  category_name String         @unique(map: "uq_tbl_categories_name") @db.VarChar(50)
  active        Boolean        @default(true)
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  tbl_products  tbl_products[]

  @@index([active], map: "idx_tbl_categories_active")
}

model tbl_coupons {
  coupon_id      BigInt       @id @default(autoincrement())
  coupon_code    String       @unique(map: "uq_tbl_coupons_code") @db.VarChar(30)
  description    String?      @db.VarChar(150)
  discount_type  String       @db.VarChar(20)
  discount_value Decimal      @db.Decimal(10, 2)
  minimum_value  Decimal?     @db.Decimal(10, 2)
  start_date     DateTime     @db.Timestamp(6)
  end_date       DateTime     @db.Timestamp(6)
  max_uses       Int?
  active         Boolean      @default(true)
  tbl_orders     tbl_orders[]

  @@index([coupon_code], map: "idx_tbl_coupons_code")
}

model tbl_customers {
  customer_id   BigInt          @id @default(autoincrement())
  full_name     String          @db.VarChar(120)
  email         String          @unique(map: "uq_tbl_customers_email") @db.VarChar(150)
  phone         String?         @db.VarChar(20)
  password_hash String          @db.VarChar(255)
  active        Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  tbl_addresses tbl_addresses[]
  tbl_carts     tbl_carts?
  tbl_orders    tbl_orders[]
  tbl_wishlist  tbl_wishlist[]

  @@index([email], map: "idx_tbl_customers_email")
}

model tbl_order_items {
  order_item_id BigInt       @id @default(autoincrement())
  order_id      BigInt
  product_id    BigInt
  quantity      Int
  unit_price    Decimal      @db.Decimal(12, 2)
  subtotal      Decimal      @db.Decimal(12, 2)
  tbl_orders    tbl_orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tbl_order_items_order")
  tbl_products  tbl_products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_order_items_product")

  @@index([order_id], map: "idx_tbl_order_items_order")
}

model tbl_orders {
  order_id        BigInt            @id @default(autoincrement())
  customer_id     BigInt
  coupon_id       BigInt?
  order_number    String            @unique(map: "uq_tbl_orders_number") @db.VarChar(30)
  subtotal_amount Decimal           @db.Decimal(12, 2)
  discount_amount Decimal           @default(0) @db.Decimal(12, 2)
  shipping_amount Decimal           @default(0) @db.Decimal(12, 2)
  total_amount    Decimal           @db.Decimal(12, 2)
  status          String            @db.VarChar(20)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  tbl_order_items tbl_order_items[]
  tbl_coupons     tbl_coupons?      @relation(fields: [coupon_id], references: [coupon_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_orders_coupon")
  tbl_customers   tbl_customers     @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_orders_customer")
  tbl_payments    tbl_payments?
}

model tbl_payments {
  payment_id       BigInt     @id @default(autoincrement())
  order_id         BigInt     @unique(map: "uq_tbl_payments_order")
  payment_method   String     @db.VarChar(20)
  transaction_code String?    @db.VarChar(120)
  amount           Decimal    @db.Decimal(12, 2)
  status           String     @db.VarChar(20)
  paid_at          DateTime?  @db.Timestamp(6)
  tbl_orders       tbl_orders @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_payments_order")
}

model tbl_product_images {
  image_id     BigInt       @id @default(autoincrement())
  product_id   BigInt
  image_url    String       @db.VarChar(500)
  sort_order   Int          @default(1) @db.SmallInt
  tbl_products tbl_products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tbl_product_images_product")

  @@index([product_id], map: "idx_tbl_product_images_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tbl_products {
  product_id          BigInt                @id @default(autoincrement())
  brand_id            BigInt
  category_id         BigInt
  sku                 String                @unique(map: "uq_tbl_products_sku") @db.VarChar(30)
  product_name        String                @db.VarChar(150)
  short_description   String?               @db.VarChar(255)
  description         String?
  price               Decimal               @db.Decimal(12, 2)
  promotional_price   Decimal?              @db.Decimal(12, 2)
  volume_ml           Int?                  @db.SmallInt
  weight_grams        Int?
  active              Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  tbl_cart_items      tbl_cart_items[]
  tbl_order_items     tbl_order_items[]
  tbl_product_images  tbl_product_images[]
  tbl_brands          tbl_brands            @relation(fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_products_brand")
  tbl_categories      tbl_categories        @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_products_category")
  tbl_stock           tbl_stock?
  tbl_stock_movements tbl_stock_movements[]
  tbl_wishlist        tbl_wishlist[]

  @@index([active], map: "idx_tbl_products_active")
  @@index([brand_id], map: "idx_tbl_products_brand")
  @@index([category_id], map: "idx_tbl_products_category")
  @@index([product_name], map: "idx_tbl_products_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tbl_stock {
  product_id   BigInt       @id
  quantity     Int          @default(0)
  updated_at   DateTime     @default(now()) @db.Timestamp(6)
  tbl_products tbl_products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_stock_product")
}

model tbl_stock_movements {
  movement_id   BigInt       @id @default(autoincrement())
  product_id    BigInt
  movement_type String       @db.VarChar(20)
  quantity      Int
  reason        String?      @db.VarChar(100)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  tbl_products  tbl_products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_stock_movements_product")

  @@index([product_id], map: "idx_tbl_stock_movements_product")
}

model tbl_wishlist {
  wishlist_id   BigInt        @id @default(autoincrement())
  customer_id   BigInt
  product_id    BigInt
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  tbl_customers tbl_customers @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_wishlist_customer")
  tbl_products  tbl_products  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tbl_wishlist_product")

  @@unique([customer_id, product_id], map: "uq_tbl_wishlist")
}
model tbl_users {
  user_id    Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       String   @default("customer") // Define se é "admin" (você) ou "customer" (cliente)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
}
